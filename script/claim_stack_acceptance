#!/usr/bin/env ruby
# frozen_string_literal: true

# Parent claim-stack acceptance for available-session claiming across Hub, Web, and TUI.
# Owns one clean Hub data directory, installs pin-matched packages, seeds unclaimed sessions,
# drives production Web dual-browser claim lanes, collates package substrate + supporting
# consumer proofs, and writes a machine-readable evidence ledger.
#
# Usage:
#   script/claim_stack_acceptance MANIFEST EVIDENCE_DIR
#   script/test-hub-flow claim-stack validate-inputs MANIFEST
#   script/test-hub-flow claim-stack run MANIFEST EVIDENCE_DIR

require "digest"
require "fileutils"
require "json"
require "open3"
require "pathname"
require "socket"
require "timeout"
require "tmpdir"
require "securerandom"

ROOT = File.expand_path("..", __dir__)
PROTOCOL = "botster-hub-daemon-v1"
TARGET_ID = "workspaces-acceptance"
MAX_UNIX_SOCKET_PATH_BYTES = 103
TERMINAL_SESSION_LIFECYCLES = %w[exited stale].freeze
FRAME_DROP_CONTROL = "transportControl.armDropNextInboundEntityFrame"
RECONNECT_CONTROL = "transportControl.closeDataChannel"
WEB_MIN_PIN = "102d39ea6c8ae7b927006dfba109171191c7b775"
WORKSPACES_MIN_PIN = "7ab4d1334214b3ea3c8b02e9ea665a27e70c0916"
HUB_MIN_PIN = "de6b09982e72fd5efd04a5258f5fc645f611adbc"
TUI_MIN_PIN = "abc804e19bc3e01465cd308c11de5f4292331c3d"

class HubExited < RuntimeError
  attr_reader :status

  def initialize(status)
    @status = status
    super("claim-stack Hub exited before socket readiness: #{status}")
  end
end

def assert(condition, message)
  raise message unless condition
end

def run!(*command, chdir: ROOT, env: {})
  stdout, stderr, status = Open3.capture3(env, *command, chdir: chdir)
  raise "command failed: #{command.join(' ')}\n#{stdout}#{stderr}" unless status.success?

  stdout
end

def run_process!(command, chdir:, env:, output_path:, timeout: 900)
  status = nil
  File.open(output_path, "w") do |output|
    pid = Process.spawn(env, *command, chdir: chdir, in: File::NULL, out: output, err: output)
    begin
      Timeout.timeout(timeout) do
        Process.waitpid(pid)
        status = $?
      end
    rescue Timeout::Error
      Process.kill("TERM", pid) rescue nil
      Process.waitpid(pid) rescue nil
      raise "timed out after #{timeout}s: #{command.join(' ')}"
    end
  end
  body = File.read(output_path)
  raise "command failed: #{command.join(' ')}\n#{body}" unless status&.success?

  body
end

def wait_for_socket(path, pid)
  Timeout.timeout(20) do
    loop do
      raise HubExited, $? if Process.waitpid(pid, Process::WNOHANG)
      begin
        socket = UNIXSocket.new(path)
        socket.close
        return
      rescue Errno::ENOENT, Errno::ECONNREFUSED
        sleep 0.05
      end
    end
  end
end

class Daemon
  def initialize(socket_path)
    @socket_path = socket_path
  end

  def request(payload)
    socket = UNIXSocket.new(@socket_path)
    socket.puts(JSON.generate(protocol: PROTOCOL))
    hello = JSON.parse(socket.gets || raise("daemon closed before hello"))
    raise "daemon protocol mismatch" unless hello["protocol"] == PROTOCOL

    socket.puts(JSON.generate(payload))
    response = JSON.parse(socket.gets || raise("daemon closed before response"))
    raise "daemon #{payload.fetch(:type)} failed: #{response['error']}" if response["error"]

    response
  ensure
    socket&.close
  end

  def call_tool(name, arguments)
    response = request(type: "plugin_mcp_call_tool", name: name, arguments: arguments)
    raise "#{name} returned #{response['kind']}" unless response["kind"] == "plugin_mcp_tool_result"

    response.fetch("plugin_tool_result")
  end
end

def validated_artifacts(manifest_path)
  output = run!(File.join(ROOT, "script", "validate_claim_stack_inputs"), manifest_path)
  JSON.parse(output).fetch("artifacts")
end

def required_absolute_new_directory(path)
  pathname = Pathname.new(path)
  raise "evidence directory must be absolute" unless pathname.absolute?
  raise "evidence directory already exists: #{path}" if pathname.exist?

  FileUtils.mkdir_p(path)
  File.realpath(path)
end

def git_revision(path)
  run!("git", "-C", path, "rev-parse", "HEAD").strip
end

def clean_git_provenance(path)
  status = run!("git", "-C", path, "status", "--porcelain", "--untracked-files=all")
  assert(status.empty?, "claim-stack harness checkout must be clean")
  { "kind" => "git_checkout", "revision" => git_revision(path), "clean" => true }
end

def assert_min_pin!(label, actual, minimum)
  assert(actual.is_a?(String) && actual.match?(/\A[0-9a-f]{40}\z/), "#{label} revision must be full sha")
  # Exact-or-newer is enforced by the operator-supplied clean checkout + Web source control presence checks.
  # Record the floor; do not invent cross-repo ancestry without the artifact checkout path.
  assert(minimum.match?(/\A[0-9a-f]{40}\z/), "#{label} minimum pin must be full sha")
end

def directory_digest(path)
  raise "Web dist directory is absent: #{path}" unless Dir.exist?(path)

  files = Dir.glob(File.join(path, "**", "*"), File::FNM_DOTMATCH).select { |entry| File.file?(entry) }.sort
  raise "Web dist directory contains no files: #{path}" if files.empty?

  digest = Digest::SHA256.new
  files.each do |entry|
    relative = entry.delete_prefix("#{path}/")
    digest << relative << "\0" << Digest::SHA256.file(entry).hexdigest << "\0"
  end
  digest.hexdigest
end

def package_proof!(daemon)
  required = %w[botster-web botster-tui botster-workspaces]
  rows = daemon.request(type: "list_packages").fetch("packages")
  required.to_h do |package_name|
    matches = rows.select { |row| row["package_name"] == package_name }
    assert(matches.length == 1, "expected exactly one installed #{package_name} package")
    row = matches.first
    assert(row["state"] == "enabled", "#{package_name} is not enabled")
    [package_name, row.slice("package_name", "version", "state", "source", "runnable_entrypoints")]
  end
end

def spawn_unclaimed_session!(daemon, session_id)
  response = daemon.request(type: "spawn", session_id: session_id, command: "sleep 3600")
  assert(!response["error"], "spawn unclaimed session failed: #{response['error']}")
  session_id
end

def create_workspace!(daemon, name)
  result = daemon.call_tool("botster_workspaces.create", { name: name })
  assert(result["ok"] == true, "workspace create failed for #{name}: #{result.inspect}")
  workspace = result["workspace"] || result.dig("result", "workspace")
  id = workspace&.fetch("id") { result["id"] || result.dig("workspace", "id") }
  assert(id.is_a?(String) && !id.empty?, "create workspace omitted id: #{result.inspect}")
  { "id" => id, "name" => name }
end

def membership_keys(daemon)
  snapshot = daemon.request(
    type: "plugin_mcp_call_tool",
    name: "botster_workspaces.entity_snapshot",
    arguments: { family: "botster-workspaces.membership" }
  )
  # Prefer tool shape; fall back to list via show.
  result = snapshot["plugin_tool_result"] || snapshot
  items = result["items"] || result.dig("snapshot", "items") || []
  Array(items).map { |item| item["session_uuid"] || item["id"] }.compact
end

def workspace_session_refs(daemon, workspace_id)
  shown = daemon.call_tool("botster_workspaces.show", { id: workspace_id })
  workspace = shown["workspace"] || shown
  Array(workspace["session_refs"])
end

def remove_membership!(daemon, workspace_id, session_uuid)
  result = daemon.call_tool("botster_workspaces.remove_session", {
    workspace_id: workspace_id,
    session_id: session_uuid,
  })
  assert(result["ok"] == true, "remove_session failed: #{result.inspect}")
  result
end

def parse_web_summary(output)
  line = output.lines.reverse.find { |candidate| candidate.start_with?("claim-stack-web-summary ") }
  raise "claim-stack web driver omitted structured summary" unless line

  JSON.parse(line.delete_prefix("claim-stack-web-summary "))
end

def action_accepted?(entry)
  result = entry["result"] || {}
  state = result["state"] || result.dig("plugin_action_result", "state") || result["status"]
  ok = result["ok"]
  idempotent = result["idempotent"] || result.dig("result", "idempotent")
  code = result.dig("error", "code") || result["code"]
  {
    "state" => state,
    "ok" => ok,
    "idempotent" => idempotent,
    "error_code" => code,
    "raw_keys" => result.is_a?(Hash) ? result.keys : [],
  }
end

def classify_race_pair(results)
  classifications = results.map { |entry| action_accepted?(entry) }
  {
    "count" => results.length,
    "request_ids" => results.map { |entry| entry["request_id"] },
    "classifications" => classifications,
  }
end

def end_and_remove_session!(daemon, hub_binary, data_dir, session_id)
  begin
    daemon.request(type: "shutdown_session", session_id: session_id)
  rescue StandardError
    nil
  end
  begin
    daemon.request(type: "remove_session", session_id: session_id)
  rescue StandardError
    # Older hubs may use delete_session
    begin
      daemon.request(type: "delete_session", session_id: session_id)
    rescue StandardError
      run!(hub_binary, "sessions", "remove", "--data-dir", data_dir, session_id) rescue nil
    end
  end
end

manifest_path, evidence_argument = ARGV
unless ARGV.length == 2
  warn "usage: script/claim_stack_acceptance MANIFEST EVIDENCE_DIR"
  exit 1
end
manifest_path = File.realpath(manifest_path)
evidence_dir = required_absolute_new_directory(evidence_argument)
artifacts = validated_artifacts(manifest_path)
harness_provenance = clean_git_provenance(ROOT)

web_path = artifacts.fetch("web_driver_source").fetch("path")
tui_path = artifacts.fetch("tui_driver_source").fetch("path")
workspaces_path = artifacts.fetch("workspaces_package").fetch("path")
hub_binary = artifacts.fetch("hub_binary").fetch("path")
worker_binary = artifacts.fetch("session_worker_binary").fetch("path")

web_revision = artifacts.fetch("web_package").fetch("revision")
tui_revision = artifacts.fetch("tui_package").fetch("revision")
workspaces_revision = artifacts.fetch("workspaces_package").fetch("revision")
hub_revision = artifacts.fetch("hub_binary").fetch("revision")
assert_min_pin!("web", web_revision, WEB_MIN_PIN)
assert_min_pin!("tui", tui_revision, TUI_MIN_PIN)
assert_min_pin!("workspaces", workspaces_revision, WORKSPACES_MIN_PIN)
assert_min_pin!("hub", hub_revision, HUB_MIN_PIN)

# Frame-drop control must exist on the Web pin (ticket_1786518263_839128).
webrtc_source = File.read(File.join(web_path, "src/botster/webrtcDaemonClient.ts"))
assert(
  webrtc_source.include?("armDropNextInboundEntityFrame"),
  "Web pin lacks armDropNextInboundEntityFrame (sequence_gap control from ticket_1786518263_839128)"
)
assert(
  webrtc_source.include?("closeDataChannel"),
  "Web pin lacks closeDataChannel reconnect control"
)

web_digest_before = directory_digest(File.join(web_path, "dist"))
binary_digests_before = %w[hub_binary session_worker_binary tui_binary].to_h do |name|
  [name, Digest::SHA256.file(artifacts.fetch(name).fetch("path")).hexdigest]
end

summary = nil
failure = nil
teardown = nil
temporary_root = Dir.exist?("/private/tmp") ? "/private/tmp" : Dir.tmpdir

Dir.mktmpdir("bwcs-", temporary_root) do |fixture_root|
  data_dir = File.join(fixture_root, "hub")
  repository = File.join(fixture_root, "repository")
  socket_path = File.join(data_dir, "botster-hub.sock")
  assert(socket_path.bytesize <= MAX_UNIX_SOCKET_PATH_BYTES, "claim-stack Hub socket path is too long")
  FileUtils.mkdir_p(repository)
  File.write(File.join(repository, "README.md"), "claim stack fixture\n")
  run!("git", "init", "--initial-branch", "main", repository)
  run!("git", "-C", repository, "config", "user.name", "Claim Stack Acceptance")
  run!("git", "-C", repository, "config", "user.email", "claim-stack.invalid")
  run!("git", "-C", repository, "add", ".")
  run!("git", "-C", repository, "commit", "-m", "Seed claim stack fixture")
  FileUtils.mkdir_p(data_dir)

  hub_log = File.open(File.join(evidence_dir, "hub.log"), "w")
  hub_pid = Process.spawn(
    hub_binary, "start", "--data-dir", data_dir, "--session-worker-bin", worker_binary,
    out: hub_log, err: hub_log
  )
  hub_status = nil
  daemon = nil
  begin
    wait_for_socket(socket_path, hub_pid)
    daemon = Daemon.new(socket_path)
    run!(
      hub_binary, "spawn-targets", "create", "--data-dir", data_dir, "--root", repository,
      "--id", TARGET_ID, "--label", "Workspaces claim stack", "--kind", "git", "--base-ref", "main"
    )
    session_type_package = File.join(ROOT, "test", "fixtures", "session-type-package")
    legacy_manifest_package = File.join(ROOT, "test", "fixtures", "legacy-session-template-manifest")
    [web_path, tui_path, workspaces_path, session_type_package, legacy_manifest_package].each do |package_path|
      run!(hub_binary, "packages", "install", "--data-dir", data_dir, "--path", package_path)
    end
    %w[
      botster-web
      botster-tui
      botster-workspaces
      botster-workspaces-acceptance-session-type
      botster-workspaces-legacy-manifest-negative
    ].each do |package_name|
      run!(hub_binary, "packages", "enable", "--data-dir", data_dir, package_name)
    end
    packages = package_proof!(daemon)
    File.write(File.join(evidence_dir, "packages.json"), JSON.pretty_generate(packages))

    # Supporting package/Hub substrate (B): real Hub smoke against this data-dir's installed package path.
    # hub_acceptance_smoke connects to the live socket; it uses package tools for substrate only.
    run_process!(
      [File.join(ROOT, "script", "hub_acceptance_smoke"), socket_path, "Claim stack substrate"],
      chdir: ROOT,
      env: {
        "BOTSTER_WORKSPACES_ACCEPTANCE_SESSION_TYPE" => "botster-workspaces-acceptance-session-type/workspace-acceptance",
      },
      output_path: File.join(evidence_dir, "hub-substrate.log"),
      timeout: 300
    )

    # Seed unclaimed running sessions for claim lanes (not membership claims).
    # Package add_session requires a canonical session UUID.
    session_s = SecureRandom.uuid
    session_s2 = SecureRandom.uuid
    session_race = SecureRandom.uuid
    session_idem = SecureRandom.uuid
    session_historical = SecureRandom.uuid
    gap_a = SecureRandom.uuid
    gap_b = SecureRandom.uuid
    gap_c = SecureRandom.uuid
    [session_s, session_s2, session_race, session_idem, session_historical, gap_a, gap_b, gap_c].each do |session_id|
      spawn_unclaimed_session!(daemon, session_id)
    end
    # Historical session must be absent from current Hub entity state at C5 time.
    end_and_remove_session!(daemon, hub_binary, data_dir, session_historical)

    w1 = create_workspace!(daemon, "Claim W1")
    w2 = create_workspace!(daemon, "Claim W2")
    File.write(File.join(evidence_dir, "seed.json"), JSON.pretty_generate({
      "sessions" => {
        "s" => session_s,
        "s2" => session_s2,
        "race" => session_race,
        "idem" => session_idem,
        "historical" => session_historical,
        "gap" => [gap_a, gap_b, gap_c],
      },
      "workspaces" => { "w1" => w1, "w2" => w2 },
    }))

    run!(hub_binary, "packages", "start-entrypoint", "--data-dir", data_dir, "botster-web", "web-client")

    assignment = {
      "workspace_w1" => w1.fetch("id"),
      "workspace_w2" => w2.fetch("id"),
      "workspace_w1_name" => w1.fetch("name"),
      "workspace_w2_name" => w2.fetch("name"),
      "session_s" => session_s,
      "session_s2" => session_s2,
      "session_race" => session_race,
      "session_idem" => session_idem,
      "session_historical" => session_historical,
      "gap_sessions" => [gap_a, gap_b, gap_c],
      "restore_session_s_after_remove" => false,
    }
    web_output = run_process!(
      ["node", File.join(ROOT, "script", "claim_stack_web_driver.mjs")],
      chdir: web_path,
      env: {
        "BOTSTER_LIVE_DATA_DIR" => data_dir,
        "BOTSTER_WEB_PACKAGE_PATH" => web_path,
        "BOTSTER_CLAIM_STACK_ASSIGNMENT" => JSON.generate(assignment),
        "PATH" => ENV.fetch("PATH"),
      },
      output_path: File.join(evidence_dir, "web-claim.log"),
      timeout: 900
    )
    web_summary = parse_web_summary(web_output)
    assert(web_summary["completed"] == true, "web claim campaign did not complete: #{web_summary['error']}")

    # Parent membership oracles for C3/C4 (DB truth, not picker-only).
    race_refs_w1 = workspace_session_refs(daemon, w1.fetch("id"))
    race_refs_w2 = workspace_session_refs(daemon, w2.fetch("id"))
    race_owners = [race_refs_w1, race_refs_w2].count { |refs| refs.include?(session_race) }
    assert(race_owners == 1, "C3 race must leave exactly one owner for session_race; w1=#{race_refs_w1} w2=#{race_refs_w2}")
    idem_refs = workspace_session_refs(daemon, w1.fetch("id"))
    assert(idem_refs.include?(session_idem), "C4 same-workspace claim missing membership for session_idem")
    # Ensure no duplicate membership across workspaces for idem session.
    assert(!race_refs_w2.include?(session_idem), "C4 session_idem must not appear on W2")

    c3 = classify_race_pair(web_summary.dig("lanes", "c3", "results") || [])
    c4 = classify_race_pair(web_summary.dig("lanes", "c4", "results") || [])
    assert(c3.fetch("request_ids").uniq.length == c3.fetch("request_ids").length, "C3 request_ids collided")
    assert(c4.fetch("request_ids").length == 2, "C4 must record two request_ids")

    # C1 remove → restore via package remove (membership path) then re-check option is parent-owned oracle.
    if workspace_session_refs(daemon, w1.fetch("id")).include?(session_s)
      remove_membership!(daemon, w1.fetch("id"), session_s)
    end
    assert(!workspace_session_refs(daemon, w1.fetch("id")).include?(session_s), "C1 remove did not clear membership")

    # Supporting consumer re-checks (section D) — separate clean Hubs by consumer design.
    # Web lifecycle rejects BOTSTER_LIVE_DATA_DIR; TUI lifecycle owns its hub.
    supporting = { "web_lifecycle" => nil, "tui_lifecycle" => nil }
    begin
      web_lifecycle_output = run_process!(
        ["npm", "run", "smoke:workspaces-lifecycle"],
        chdir: web_path,
        env: {
          "BOTSTER_HUB_BIN" => hub_binary,
          "BOTSTER_SESSION_WORKER_BIN" => worker_binary,
          "BOTSTER_WORKSPACES_PACKAGE_PATH" => workspaces_path,
          "PATH" => ENV.fetch("PATH"),
        },
        output_path: File.join(evidence_dir, "supporting-web-lifecycle.log"),
        timeout: 1200
      )
      supporting["web_lifecycle"] = {
        "status" => "passed",
        "marker" => web_lifecycle_output.include?("workspaces lifecycle live proof passed"),
        "pin" => web_revision,
      }
      assert(supporting["web_lifecycle"]["marker"], "supporting Web lifecycle missing pass marker")
    rescue StandardError => error
      supporting["web_lifecycle"] = { "status" => "failed", "error" => error.message, "pin" => web_revision }
      raise
    end

    begin
      tui_output = run_process!(
        [File.join(tui_path, "script", "test-live-hub"), "workspaces", "lifecycle"],
        chdir: tui_path,
        env: {
          "BOTSTER_HUB_BIN" => hub_binary,
          "BOTSTER_SESSION_WORKER_BIN" => worker_binary,
          "BOTSTER_WORKSPACES_PACKAGE_PATH" => workspaces_path,
          "PATH" => ENV.fetch("PATH"),
        },
        output_path: File.join(evidence_dir, "supporting-tui-lifecycle.log"),
        timeout: 1200
      )
      supporting["tui_lifecycle"] = {
        "status" => "passed",
        "marker" => tui_output.include?("workspaces-acceptance: profile=Lifecycle ledger=complete") || tui_output.include?("Lifecycle"),
        "pin" => tui_revision,
      }
    rescue StandardError => error
      supporting["tui_lifecycle"] = { "status" => "failed", "error" => error.message, "pin" => tui_revision }
      # TUI supporting failure is recorded; parent Web campaign still required. Do not swallow.
      raise
    end

    binary_digests_after = binary_digests_before.keys.to_h do |name|
      [name, Digest::SHA256.file(artifacts.fetch(name).fetch("path")).hexdigest]
    end
    assert(binary_digests_after == binary_digests_before, "a supplied runtime binary changed during acceptance")
    assert(directory_digest(File.join(web_path, "dist")) == web_digest_before, "Web dist changed during acceptance")

    summary = {
      "schema_version" => 1,
      "status" => "passed",
      "shared_data_directory" => true,
      "one_hub_process" => true,
      "target_repository" => "botster-workspaces",
      "frame_drop_control" => FRAME_DROP_CONTROL,
      "reconnect_control" => RECONNECT_CONTROL,
      "web_dependency_ticket" => "ticket_1786518263_839128",
      "pins" => {
        "hub" => hub_revision,
        "web" => web_revision,
        "tui" => tui_revision,
        "workspaces" => workspaces_revision,
        "minima" => {
          "hub" => HUB_MIN_PIN,
          "web" => WEB_MIN_PIN,
          "tui" => TUI_MIN_PIN,
          "workspaces" => WORKSPACES_MIN_PIN,
        },
      },
      "artifacts" => artifacts.transform_values { |artifact| artifact.reject { |key, _| %w[path source_checkout].include?(key) } }
        .merge("claim_stack_harness" => harness_provenance),
      "binary_sha256" => binary_digests_before,
      "web_dist_sha256" => web_digest_before,
      "packages" => packages,
      "web_campaign" => web_summary,
      "membership_oracles" => {
        "c3_race_owner_count" => race_owners,
        "c3_w1_refs" => race_refs_w1,
        "c3_w2_refs" => race_refs_w2,
        "c4_w1_has_idem" => idem_refs.include?(session_idem),
        "c1_removed" => !workspace_session_refs(daemon, w1.fetch("id")).include?(session_s),
      },
      "spa_request_state" => {
        "c3" => c3,
        "c4" => c4,
      },
      "supporting_consumers" => supporting,
      "forbidden_methods_audit" => web_summary["forbidden_methods_audit"],
      "production_entry_point" =>
        "Workspaces app surface → Add existing session → Available sessions entity_options " \
        "(or advanced historical when absent) → realized botster_workspaces.add_session with " \
        "correlated request_id → membership batch + entity_publish → generic Web entity stores " \
        "update open pickers; reconnect baselines replace entity stores from authoritative snapshots; " \
        "ordered gap uses #{FRAME_DROP_CONTROL} before receiveEntityFrame.",
      "completed" => true,
    }
  rescue StandardError => error
    failure = error
    hub_status = error.status if error.is_a?(HubExited)
    File.write(File.join(evidence_dir, "failure.json"), JSON.pretty_generate({
      "status" => "failed",
      "error_class" => error.class.name,
      "message" => error.message,
    }))
  ensure
    if failure.nil? && daemon
      begin
        pre_shutdown_sessions = daemon.request(type: "list_sessions").fetch("sessions")
        nonterminal = pre_shutdown_sessions.reject { |row| TERMINAL_SESSION_LIFECYCLES.include?(row["lifecycle"]) }
        # Claim stack intentionally leaves sleep sessions running; shut them down before hub stop.
        nonterminal.each do |row|
          sid = row["session_id"] || row["session_uuid"]
          begin
            daemon.request(type: "shutdown_session", session_id: sid)
          rescue StandardError
            nil
          end
        end
        # Re-check with a short bound.
        Timeout.timeout(15) do
          loop do
            sessions = daemon.request(type: "list_sessions").fetch("sessions")
            break if sessions.all? { |row| TERMINAL_SESSION_LIFECYCLES.include?(row["lifecycle"]) }

            sleep 0.1
          end
        end
      rescue StandardError => error
        failure ||= error
      end
    end
    shutdown_stdout, shutdown_stderr, shutdown_status = Open3.capture3(hub_binary, "shutdown", "--data-dir", data_dir)
    shutdown_ok = shutdown_status.success?
    teardown = {
      "shutdown_ok" => shutdown_ok,
      "shutdown_stdout" => shutdown_stdout,
      "shutdown_stderr" => shutdown_stderr,
    }
    process_status = hub_status
    reaped = !process_status.nil?
    unless reaped
      begin
        reaped = Process.waitpid(hub_pid, Process::WNOHANG)
        process_status = $? if reaped
      rescue Errno::ECHILD
        reaped = true
      end
    end
    unless reaped
      begin
        Timeout.timeout(10) do
          Process.waitpid(hub_pid)
          process_status = $?
        end
      rescue Timeout::Error
        Process.kill("TERM", hub_pid) rescue nil
        begin
          Process.waitpid(hub_pid)
          process_status = $?
        rescue Errno::ECHILD
          nil
        end
      end
    end
    hub_status = process_status
    hub_log.close
    unless shutdown_ok && hub_status&.success?
      detail = [shutdown_stdout, shutdown_stderr].reject(&:empty?).join
      failure ||= RuntimeError.new("claim-stack Hub cleanup failed: #{detail}")
    end
  end
end

if failure
  File.write(File.join(evidence_dir, "failure.json"), JSON.pretty_generate({
    "status" => "failed",
    "error_class" => failure.class.name,
    "message" => failure.message,
    "teardown" => teardown,
  }))
  raise failure
end

summary["teardown"] = teardown
File.write(File.join(evidence_dir, "summary.json"), JSON.pretty_generate(summary))
puts "script/claim_stack_acceptance: ok evidence=#{evidence_dir}"
