#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "socket"

ROOT = File.expand_path("..", __dir__)
PACKAGE = "botster-workspaces"
SURFACE = "workspaces"
PROTOCOL = "botster-hub-daemon-v1"
PROTOCOL_VERSION = 6
CONFORMANCE_FIXTURE_REVISION = 31
SESSION_TYPE_FEATURE = "session_type_entity_subscriptions"
LEGACY_MANIFEST_PACKAGE = "botster-workspaces-legacy-manifest-negative"
LEGACY_MANIFEST_SESSION_TYPE_ID = "#{LEGACY_MANIFEST_PACKAGE}/legacy-acceptance"

socket_path = ARGV.fetch(0) do
  warn "usage: script/hub_acceptance_smoke <isolated-current-hub.sock> [workspace-name]"
  exit 1
end
workspace_name = ARGV[1] || "Acceptance Workspace"
branch = ENV.fetch("BOTSTER_WORKSPACES_ACCEPTANCE_BRANCH", "botster-workspaces-acceptance-#{Process.pid}")

def assert(condition, message)
  raise message unless condition
end

# The Hub deserializes DaemonHello.compatibility with field-level defaults but no
# per-field defaults inside DaemonCompatibilityRequirement, so a present block is
# only accepted when it carries the exact protocol-6 shape.
def compatibility_requirement(client_name, required_features)
  {
    protocol: PROTOCOL,
    protocol_version: PROTOCOL_VERSION,
    required_features: required_features,
    minimum_conformance_fixture_revision: CONFORMANCE_FIXTURE_REVISION,
    client_name: client_name,
  }
end

def assert_hello_ack!(hello, label)
  assert(hello["protocol"] == PROTOCOL, "#{label} daemon hello failed")
  compatibility = hello.fetch("compatibility") { raise "#{label} daemon hello omitted compatibility" }
  assert(compatibility["protocol"] == PROTOCOL, "#{label} daemon advertised #{compatibility["protocol"].inspect}")
  assert(
    compatibility["protocol_version"] == PROTOCOL_VERSION,
    "#{label} daemon advertised protocol_version #{compatibility["protocol_version"].inspect}"
  )
  assert(
    compatibility["conformance_fixture_revision"] == CONFORMANCE_FIXTURE_REVISION,
    "#{label} daemon advertised conformance_fixture_revision #{compatibility["conformance_fixture_revision"].inspect}"
  )
  assert(
    Array(compatibility["features"]).include?(SESSION_TYPE_FEATURE),
    "#{label} daemon does not advertise #{SESSION_TYPE_FEATURE}"
  )
  compatibility
end

def request_raw(socket, payload)
  socket.puts(JSON.generate(payload))
  line = socket.gets
  raise "daemon closed before #{payload.fetch(:type)} response" unless line

  JSON.parse(line)
end

def request(socket, payload)
  response = request_raw(socket, payload)
  if response["error"]
    raise "daemon #{payload.fetch(:type)} failed: #{response["error"]}"
  end
  response
end

def call_tool(socket, name, arguments)
  response = request(socket, {
    type: "plugin_mcp_call_tool",
    name: name,
    arguments: arguments,
  })
  assert(response["kind"] == "plugin_mcp_tool_result", "#{name} returned #{response["kind"]}")
  response.fetch("plugin_tool_result")
end

def render_surface(socket)
  response = request(socket, {
    type: "plugin_surface_render",
    package_name: PACKAGE,
    surface_id: SURFACE,
    payload: {},
  })
  assert(response["kind"] == "plugin_surface", "workspaces did not return plugin surface")
  surface = response.fetch("plugin_surface")
  assert(surface["package_name"] == PACKAGE, "surface package identity mismatch")
  assert(surface["surface_id"] == SURFACE, "surface id mismatch")
  snapshot = surface.fetch("ui_tree_snapshot")
  assert(snapshot["package_name"] == PACKAGE, "snapshot package identity mismatch")
  assert(snapshot["surface_id"] == SURFACE, "snapshot surface identity mismatch")
  snapshot.fetch("body")
end

def children(node)
  values = Array(node["children"])
  (node["slots"] || {}).each_value { |slot| values.concat(Array(slot)) }
  values << node["node"] if node["$kind"] == "presentation_if" && node["node"]
  if node["$kind"] == "bind_list"
    values << node["item_template"]
    values << node["empty_template"] if node["empty_template"]
  end
  values
end

def find_node(node, id)
  return node if node["id"] == id

  children(node).each do |child|
    found = find_node(child, id)
    return found if found
  end
  nil
end

def find_nodes_by_action_id(node, action_id, result = [])
  result << node if node.dig("props", "action", "id") == action_id
  children(node).each { |child| find_nodes_by_action_id(child, action_id, result) }
  result
end

def collect_types(node, result = Hash.new(0))
  result[node["type"]] += 1 if node["type"]
  children(node).each { |child| collect_types(child, result) }
  result
end

def open_session_entity_subscription(socket_path, subscription_id)
  socket = UNIXSocket.new(socket_path)
  socket.puts(JSON.generate({
    protocol: PROTOCOL,
    compatibility: compatibility_requirement(
      "botster-workspaces-session-entity-smoke",
      ["session_entity_subscriptions"]
    ),
  }))
  hello = JSON.parse(socket.gets || raise("daemon closed before entity subscription hello"))
  assert_hello_ack!(hello, "entity subscription")
  socket.puts(JSON.generate({
    type: "subscribe_entities",
    entity_type: "session",
    subscription_id: subscription_id,
  }))
  response = JSON.parse(socket.gets || raise("daemon closed before entity subscription response"))
  assert(response["kind"] == "entity_subscribed", "session entity subscription was not accepted")
  [socket, JSON.parse(socket.gets || raise("daemon closed before authoritative entity snapshot"))]
end

def wait_for_entity_frame(socket, label, timeout: 15)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
  observed = []
  loop do
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise("timed out waiting for #{label}; observed=#{observed.inspect}") if remaining <= 0

    ready = IO.select([socket], nil, nil, remaining)
    raise("timed out waiting for #{label}; observed=#{observed.inspect}") unless ready

    frame = JSON.parse(socket.gets || raise("daemon closed while waiting for #{label}"))
    return frame if yield(frame)
    observed << frame
  end
end

def action(socket, id:, node_id:, kind:, payload: nil, values: nil)
  response = request(socket, {
    type: "plugin_surface_action",
    package_name: PACKAGE,
    request: {
      request_id: "workspaces-acceptance-#{Process.pid}-#{node_id}",
      surface_id: SURFACE,
      action_id: id,
      node_id: node_id,
      kind: kind,
      payload: payload,
      values: values,
    }.compact,
  })
  assert(response["kind"] == "plugin_action_result", "#{id} did not return plugin action result")
  response.fetch("plugin_action_result")
end

def assert_rejected(result, field_id, label)
  assert(result["state"] == "rejected", "#{label} was not rejected")
  assert(result.fetch("field_errors").key?(field_id), "#{label} did not key its error to #{field_id}")
  assert(Array(result["form_errors"]).any?, "#{label} did not retain a form error")
  assert(!result.key?("presentation"), "#{label} unexpectedly mutated presentation")
  assert(!result.key?("replacement"), "#{label} unexpectedly replaced the surface")
end

socket = UNIXSocket.new(socket_path)
socket.puts(JSON.generate({
  protocol: PROTOCOL,
  compatibility: compatibility_requirement("botster-workspaces-acceptance-smoke", %w[
    sessions
    package_routes
    package_navigation
    plugin_surface_render
    plugin_surface_action
    spawn_targets
    worktrees
  ]),
}))
hello = JSON.parse(socket.gets || raise("daemon closed before hello"))
hub_compatibility = assert_hello_ack!(hello, "acceptance")

entity_socket, initial_entity_snapshot = open_session_entity_subscription(
  socket_path,
  "workspaces-lifecycle-initial-#{Process.pid}"
)
assert(initial_entity_snapshot["type"] == "entity_snapshot", "session subscription missing authoritative baseline")
assert(initial_entity_snapshot["entity_type"] == "session", "session subscription returned wrong entity family")

packages = request(socket, { type: "list_packages" })
package = packages.fetch("packages").find { |candidate| candidate["package_name"] == PACKAGE }
unless package
  request(socket, { type: "install_package_local_path", path: ROOT })
  packages = request(socket, { type: "list_packages" })
  package = packages.fetch("packages").find { |candidate| candidate["package_name"] == PACKAGE }
end
assert(package, "package install did not register botster-workspaces")
if package["state"] != "enabled"
  request(socket, { type: "enable_package", package_name: PACKAGE })
end
request(socket, { type: "reload_package", package_name: PACKAGE })

packages = request(socket, { type: "list_packages" })
package = packages.fetch("packages").find { |candidate| candidate["package_name"] == PACKAGE }
assert(package && package["state"] == "enabled", "package must be enabled")
surfaces = package.fetch("surfaces")
assert(surfaces.length == 1, "package must expose one app surface")
assert(surfaces.first["id"] == SURFACE, "package must expose the stable Workspaces surface")
assert(surfaces.first["kind"] == "app", "Workspaces surface must be an app")
assert(
  surfaces.first["supports"] == ["render", "action"],
  "Workspaces surface must project exact render/action support"
)
assert(
  package.fetch("routes").any? { |route| route["route_id"] == "surface:workspaces" },
  "stable Workspaces route missing"
)

# Present only when the isolated flow installed it; the smoke also runs standalone.
legacy_manifest_package = packages.fetch("packages").find do |candidate|
  candidate["package_name"] == LEGACY_MANIFEST_PACKAGE
end
if legacy_manifest_package
  assert(
    legacy_manifest_package["state"] == "enabled",
    "legacy-manifest negative control must be enabled to prove the key is ignored, not rejected"
  )
end

tools = request(socket, { type: "plugin_mcp_list_tools" })
tool_names = tools.fetch("plugin_tools").map { |tool| tool.fetch("name") }
%w[
  botster_workspaces.create
  botster_workspaces.list
  botster_workspaces.show
  botster_workspaces.rename
  botster_workspaces.delete
  botster_workspaces.add_session
  botster_workspaces.move_session
  botster_workspaces.remove_session
  botster_workspaces.spawn
  botster_workspaces.entity_snapshot
].each do |name|
  assert(tool_names.include?(name), "missing plugin MCP tool #{name}")
end

# The published spawn descriptor is the downstream agent contract. Name discovery
# and handler success do not prove a schema-driven agent can construct the
# migrated call, so assert the exact descriptor the Hub publishes.
spawn_descriptor = tools.fetch("plugin_tools").find { |tool| tool.fetch("name") == "botster_workspaces.spawn" }
assert(spawn_descriptor, "Hub published no botster_workspaces.spawn descriptor")
assert(
  spawn_descriptor.fetch("description") ==
    "Atomically ensure a Hub-managed worktree, spawn a session, and record its returned UUID.",
  "published spawn description drifted: #{spawn_descriptor.fetch("description").inspect}"
)
# The Hub serializes McpToolDescriptor with rename_all = "camelCase", so the
# published key is inputSchema even though the Lua spec authors input_schema.
spawn_schema = spawn_descriptor.fetch("inputSchema")
assert(spawn_schema["type"] == "object", "published spawn schema is not an object schema")
assert(spawn_schema["additionalProperties"] == false, "published spawn schema does not forbid additional properties")
assert(
  spawn_schema.fetch("properties").keys.sort == %w[branch prompt session_type_id target_id ticket_id workspace_id],
  "published spawn properties drifted: #{spawn_schema.fetch("properties").keys.sort.inspect}"
)
spawn_schema.fetch("properties").each do |property, definition|
  assert(definition["type"] == "string", "published spawn property #{property} is not typed string")
end
assert(
  spawn_schema.fetch("required") == %w[workspace_id target_id branch session_type_id],
  "published spawn required set drifted: #{spawn_schema.fetch("required").inspect}"
)
assert(
  !JSON.generate(spawn_descriptor).include?("template_id"), # cold-cut negative control
  "published spawn descriptor still advertises the superseded request field"
)

initial_surface = render_surface(socket)
types = collect_types(initial_surface)
assert(types["panel"].positive?, "surface missing panel")
assert(types["toolbar"].positive?, "surface missing toolbar")
assert(types["list"].positive?, "surface missing workspace list")
new_button = find_node(initial_surface, "botster-workspaces-new")
assert(new_button, "surface missing contextual New workspace control")
new_action = new_button.dig("props", "action")
assert(new_action && new_action["id"], "New workspace control has no action metadata")

opened = action(
  socket,
  id: new_action.fetch("id"),
  node_id: new_button.fetch("id"),
  kind: "submit",
  payload: new_action["payload"]
)
assert(opened["state"] == "accepted", "New workspace open action was not accepted")
assert(
  opened.fetch("presentation").any? { |operation| operation["kind"] == "set" && operation["key"] == "workspace-dialog" },
  "New workspace did not author presentation state"
)

rejected_create = action(
  socket,
  id: "botster_workspaces.create",
  node_id: "botster-workspaces-create-form",
  kind: "submit",
  values: {}
)
assert_rejected(rejected_create, "botster-workspaces-create-name", "missing workspace name")

created_action = action(
  socket,
  id: "botster_workspaces.create",
  node_id: "botster-workspaces-create-form",
  kind: "submit",
  values: { "botster-workspaces-create-name" => workspace_name }
)
if created_action["state"] == "accepted"
  workspace_id = created_action.dig("payload", "workspace", "id")
else
  assert(created_action["state"] == "error", "duplicate create returned unexpected state")
  existing = call_tool(socket, "botster_workspaces.list", {})
  row = existing.fetch("workspaces").find { |candidate| candidate["name"] == workspace_name }
  assert(row, "workspace create failed and existing row was not found")
  workspace_id = row.fetch("id")
end
assert(workspace_id, "workspace id missing")

populated_surface = render_surface(socket)
row = find_node(populated_surface, "botster-workspaces-row-#{workspace_id}")
assert(row, "post-create surface missing workspace row")
row_action = row.dig("props", "action")
selected = action(
  socket,
  id: row_action.fetch("id"),
  node_id: row.fetch("id"),
  kind: "submit",
  payload: row_action["payload"]
)
assert(selected["state"] == "accepted", "workspace selection was not accepted")
assert(
  selected.fetch("presentation").any? do |operation|
    operation["kind"] == "set" &&
      operation["key"] == "selected-workspace" &&
      operation["value"] == workspace_id
  end,
  "workspace selection did not author scoped detail state"
)

rename_form = find_node(populated_surface, "botster-workspaces-rename-form-#{workspace_id}")
assert(rename_form, "selected workspace is missing the rendered Rename form")
rejected_rename = action(
  socket,
  id: rename_form.dig("props", "action", "id"),
  node_id: rename_form.fetch("id"),
  kind: "submit",
  payload: rename_form.dig("props", "action", "payload"),
  values: { "botster-workspaces-rename-name" => "" }
)
assert_rejected(rejected_rename, "botster-workspaces-rename-name", "missing rename value")
renamed_workspace_name = "#{workspace_name} Renamed"
renamed_action = action(
  socket,
  id: rename_form.dig("props", "action", "id"),
  node_id: rename_form.fetch("id"),
  kind: "submit",
  payload: rename_form.dig("props", "action", "payload"),
  values: { "botster-workspaces-rename-name" => renamed_workspace_name }
)
assert(renamed_action["state"] == "accepted", "Rename action was not accepted")
assert(
  call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("workspace", "name") == renamed_workspace_name,
  "Rename action did not persist the new name"
)

destination_name = "#{workspace_name} Destination"
destination_action = action(
  socket,
  id: "botster_workspaces.create",
  node_id: "botster-workspaces-create-form",
  kind: "submit",
  values: { "botster-workspaces-create-name" => destination_name }
)
if destination_action["state"] == "accepted"
  destination_workspace_id = destination_action.dig("payload", "workspace", "id")
else
  assert(destination_action["state"] == "error", "destination create returned unexpected state")
  destination_workspace_id = call_tool(socket, "botster_workspaces.list", {})
    .fetch("workspaces")
    .find { |candidate| candidate["name"] == destination_name }
    &.fetch("id")
end
assert(destination_workspace_id, "destination workspace id missing")

membership_session_id = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
action_surface = render_surface(socket)
add_form = find_node(action_surface, "botster-workspaces-add-form-#{workspace_id}")
assert(add_form, "selected workspace is missing the rendered Add session form")
rejected_add = action(
  socket,
  id: add_form.dig("props", "action", "id"),
  node_id: add_form.fetch("id"),
  kind: "submit",
  payload: add_form.dig("props", "action", "payload"),
  values: { "botster-workspaces-add-session-id" => "1-2-3-4-5" }
)
assert_rejected(rejected_add, "botster-workspaces-add-session-id", "non-canonical Add session UUID")
added_action = action(
  socket,
  id: add_form.dig("props", "action", "id"),
  node_id: add_form.fetch("id"),
  kind: "submit",
  payload: add_form.dig("props", "action", "payload"),
  values: { "botster-workspaces-add-session-id" => membership_session_id }
)
assert(added_action["state"] == "accepted", "Add session action was not accepted")
assert(
  call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("workspace", "session_refs") == [membership_session_id],
  "Add session action did not persist membership"
)

move_surface = render_surface(socket)
move_form = find_node(move_surface, "botster-workspaces-move-form-#{workspace_id}")
assert(move_form, "selected workspace is missing the rendered Move session form")
rejected_move = action(
  socket,
  id: move_form.dig("props", "action", "id"),
  node_id: move_form.fetch("id"),
  kind: "submit",
  payload: move_form.dig("props", "action", "payload"),
  values: {
    "botster-workspaces-move-destination-id" => destination_workspace_id,
    "botster-workspaces-move-session-id" => "",
  }
)
assert_rejected(rejected_move, "botster-workspaces-move-session-id", "missing Move session UUID")
moved_action = action(
  socket,
  id: move_form.dig("props", "action", "id"),
  node_id: move_form.fetch("id"),
  kind: "submit",
  payload: move_form.dig("props", "action", "payload"),
  values: {
    "botster-workspaces-move-destination-id" => destination_workspace_id,
    "botster-workspaces-move-session-id" => membership_session_id,
  }
)
assert(moved_action["state"] == "accepted", "Move session action was not accepted")
assert(
  call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("workspace", "session_refs").empty?,
  "Move session action did not clear source membership"
)
assert(
  call_tool(socket, "botster_workspaces.show", { id: destination_workspace_id }).dig("workspace", "session_refs") == [membership_session_id],
  "Move session action did not persist destination membership"
)

remove_surface = render_surface(socket)
remove_button = find_node(
  remove_surface,
  "botster-workspaces-remove-absent-#{destination_workspace_id}-#{membership_session_id}"
)
assert(remove_button, "destination workspace is missing the rendered Remove session action")
remove_metadata = remove_button.dig("props", "action")
removed_action = action(
  socket,
  id: remove_metadata.fetch("id"),
  node_id: remove_button.fetch("id"),
  kind: "submit",
  payload: remove_metadata["payload"]
)
assert(removed_action["state"] == "accepted", "Remove session action was not accepted")
assert(!removed_action.key?("presentation"), "Remove session action emitted empty presentation operations")
assert(
  call_tool(socket, "botster_workspaces.show", { id: destination_workspace_id }).dig("workspace", "session_refs").empty?,
  "Remove session action did not remove destination membership"
)

delete_destination_surface = render_surface(socket)
delete_destination_form = find_node(
  delete_destination_surface,
  "botster-workspaces-delete-form-#{destination_workspace_id}"
)
assert(delete_destination_form, "destination workspace is missing the rendered Delete form")
rejected_delete = action(
  socket,
  id: delete_destination_form.dig("props", "action", "id"),
  node_id: delete_destination_form.fetch("id"),
  kind: "submit",
  payload: delete_destination_form.dig("props", "action", "payload"),
  values: { "botster-workspaces-delete-workspace-id" => "" }
)
assert_rejected(rejected_delete, "botster-workspaces-delete-workspace-id", "missing Delete workspace id")
deleted_destination = action(
  socket,
  id: delete_destination_form.dig("props", "action", "id"),
  node_id: delete_destination_form.fetch("id"),
  kind: "submit",
  payload: delete_destination_form.dig("props", "action", "payload")
)
assert(deleted_destination["state"] == "accepted", "Delete destination action was not accepted")
assert(
  call_tool(socket, "botster_workspaces.show", { id: destination_workspace_id }).dig("error", "code") == "workspace_not_found",
  "Delete destination action left the grouping"
)

populated_surface = render_surface(socket)
targets_response = request(socket, { type: "list_spawn_targets" })
targets = targets_response.fetch("spawn_targets") do
  raise "list_spawn_targets returned unexpected frame #{targets_response.inspect}"
end
target = targets.find { |candidate| candidate["enabled"] && candidate["kind"] == "git" }
assert(target, "acceptance Hub needs one enabled Git spawn target")

spawn_buttons = find_nodes_by_action_id(populated_surface, "botster_workspaces.open_spawn")
assert(spawn_buttons.length == 1, "selected workspace must expose exactly one semantic Spawn opener")
spawn_button = spawn_buttons.fetch(0)
spawn_action = spawn_button.dig("props", "action")
assert(spawn_button.dig("props", "label") == "Spawn", "semantic Spawn opener changed visible copy")
assert(spawn_button.fetch("id") == "botster-workspaces-spawn-#{workspace_id}", "semantic Spawn opener changed authored node id")
assert(spawn_action.fetch("id") != "botster_workspaces.open", "semantic Spawn opener retained generic action identity")
opened_spawn = action(
  socket,
  id: spawn_action.fetch("id"),
  node_id: spawn_button.fetch("id"),
  kind: "submit",
  payload: spawn_action["payload"]
)
assert(opened_spawn["state"] == "accepted", "Spawn action did not open target selection")
assert(opened_spawn["action_id"] == spawn_action.fetch("id"), "Spawn result did not echo read-back action identity")
assert(opened_spawn["node_id"] == spawn_button.fetch("id"), "Spawn result did not echo read-back node identity")
target_form = find_node(render_surface(socket), "botster-workspaces-spawn-target-form-#{workspace_id}")
assert(target_form, "Spawn action did not render target-first selection")
selected_target = action(
  socket,
  id: target_form.dig("props", "action", "id"),
  node_id: target_form.fetch("id"),
  kind: "submit",
  payload: target_form.dig("props", "action", "payload"),
  values: { "botster-workspaces-spawn-target" => target.fetch("target_id") }
)
assert(selected_target["state"] == "accepted", "Git target selection was not accepted")
session_type_select = find_node(selected_target.fetch("replacement"), "botster-workspaces-spawn-template")
assert(session_type_select, "selected Git target has no effective session-type selector")
session_type_option = Array(session_type_select.dig("slots", "options")).first
if ENV["BOTSTER_WORKSPACES_ACCEPTANCE_SESSION_TYPE"]
  session_type_option = Array(session_type_select.dig("slots", "options")).find do |option|
    option.dig("props", "value") == ENV.fetch("BOTSTER_WORKSPACES_ACCEPTANCE_SESSION_TYPE")
  end
end
assert(session_type_option, "selected Git target has no effective session type")
session_type_id = session_type_option.dig("props", "value")
assert(session_type_id, "effective session type is missing its id")
assert(
  session_type_id.include?("/"),
  "effective session type id is not fully qualified: #{session_type_id.inspect}"
)

# The Hub deserializes local manifests with serde defaults and no
# deny_unknown_fields, so an enabled package that still declares the superseded
# manifest key is admitted but contributes no effective session type. Prove that
# it cannot reach the selector rather than assuming parse-time rejection.
if legacy_manifest_package
  offered_session_type_ids = Array(session_type_select.dig("slots", "options")).map { |option| option.dig("props", "value") }
  assert(
    offered_session_type_ids.none? { |id| id.to_s.start_with?("#{LEGACY_MANIFEST_PACKAGE}/") },
    "superseded manifest key contributed an effective session type: #{offered_session_type_ids.inspect}"
  )
end

spawn_form = find_node(selected_target.fetch("replacement"), "botster-workspaces-spawn-form-#{workspace_id}-#{target.fetch("target_id")}")
assert(spawn_form, "target selection did not render the Spawn form")
rejected_spawn_action = action(
  socket,
  id: spawn_form.dig("props", "action", "id"),
  node_id: spawn_form.fetch("id"),
  kind: "submit",
  payload: spawn_form.dig("props", "action", "payload"),
  values: {
    "botster-workspaces-spawn-branch" => "",
    "botster-workspaces-spawn-template" => session_type_id,
  }
)
assert_rejected(rejected_spawn_action, "botster-workspaces-spawn-branch", "missing Spawn branch")
spawned_action = action(
  socket,
  id: spawn_form.dig("props", "action", "id"),
  node_id: spawn_form.fetch("id"),
  kind: "submit",
  payload: spawn_form.dig("props", "action", "payload"),
  values: {
    "botster-workspaces-spawn-branch" => branch,
    "botster-workspaces-spawn-template" => session_type_id,
    "botster-workspaces-spawn-prompt" => "Workspaces acceptance smoke",
  }
)
assert(spawned_action["state"] == "accepted", "real atomic Hub Spawn action failed: #{spawned_action}")
spawned = spawned_action.fetch("payload")
assert(spawned["ok"] == true, "real atomic Hub spawn payload failed: #{spawned}")
session_id = spawned.fetch("session_id")
assert(session_id == spawned.dig("hub_result", "session_id"), "workspace did not persist returned Hub UUID")
assert(spawned.fetch("workspace").fetch("session_refs").count(session_id) == 1, "returned UUID not persisted exactly once")

current_frame = wait_for_entity_frame(entity_socket, "current session entity") do |frame|
  frame["type"] == "entity_upsert" &&
    frame["id"] == session_id &&
    frame.dig("entity", "lifecycle_class") == "current"
end
assert(current_frame.dig("entity", "session_uuid") == session_id, "current entity lost canonical UUID")
assert(
  current_frame.dig("entity", "session_type_id") == session_type_id,
  "canonical session entity lost the selected session type: #{current_frame.dig("entity", "session_type_id").inspect}"
)
worktree_id = spawned.dig("hub_result", "worktree_id")
worktrees = request(socket, { type: "list_worktrees" }).fetch("worktrees")
assert(worktrees.any? { |worktree| worktree["worktree_id"] == worktree_id }, "managed worktree is not observable")

request(socket, { type: "reload_package", package_name: PACKAGE })
after_restart = call_tool(socket, "botster_workspaces.show", { id: workspace_id })
assert(after_restart.fetch("workspace").fetch("session_refs").include?(session_id), "restart lost returned UUID membership")

membership_before_failure = after_restart.fetch("workspace").fetch("session_refs")
failed_spawn = call_tool(socket, "botster_workspaces.spawn", {
  workspace_id: workspace_id,
  target_id: "missing-workspaces-acceptance-target",
  branch: "#{branch}-negative",
  session_type_id: session_type_id,
})
assert(failed_spawn["ok"] == false, "negative real Hub spawn unexpectedly succeeded")
after_failure = call_tool(socket, "botster_workspaces.show", { id: workspace_id })
assert(
  after_failure.fetch("workspace").fetch("session_refs") == membership_before_failure,
  "failed Hub spawn changed membership"
)

# The superseded request field is rejected by the real installed package before
# any Hub capability call; it is never translated into session_type_id.
obsolete_field_spawn = call_tool(socket, "botster_workspaces.spawn", {
  workspace_id: workspace_id,
  target_id: target.fetch("target_id"),
  branch: "#{branch}-obsolete-field",
  template_id: session_type_id, # cold-cut negative control
})
assert(obsolete_field_spawn["ok"] == false, "real Hub accepted the superseded spawn request field")
assert(
  obsolete_field_spawn.dig("error", "code") == "unknown_field",
  "superseded spawn request field returned #{obsolete_field_spawn.dig("error", "code").inspect}"
)
assert(
  call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("workspace", "session_refs") == membership_before_failure,
  "superseded spawn request field changed membership"
)

# The superseded manifest key is not translated into a spawnable session type.
if legacy_manifest_package
  legacy_manifest_spawn = call_tool(socket, "botster_workspaces.spawn", {
    workspace_id: workspace_id,
    target_id: target.fetch("target_id"),
    branch: "#{branch}-legacy-manifest",
    session_type_id: LEGACY_MANIFEST_SESSION_TYPE_ID,
  })
  assert(legacy_manifest_spawn["ok"] == false, "superseded manifest key produced a spawnable session type")
  assert(
    legacy_manifest_spawn.dig("error", "code") == "unknown_session_type",
    "superseded manifest key returned #{legacy_manifest_spawn.dig("error", "code").inspect} instead of unknown_session_type"
  )
  assert(
    call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("workspace", "session_refs") == membership_before_failure,
    "superseded manifest spawn attempt changed membership"
  )
end

removed_spawned = call_tool(socket, "botster_workspaces.spawn", {
  workspace_id: workspace_id,
  target_id: target.fetch("target_id"),
  branch: "#{branch}-removed",
  session_type_id: session_type_id,
})
assert(removed_spawned["ok"] == true, "second package-owned Hub spawn failed")
removed_session_id = removed_spawned.fetch("session_id")
wait_for_entity_frame(entity_socket, "second current session entity") do |frame|
  frame["type"] == "entity_upsert" && frame["id"] == removed_session_id
end
unknown_session_id = "99999999-9999-4999-8999-999999999999"
call_tool(socket, "botster_workspaces.add_session", { workspace_id: workspace_id, session_id: unknown_session_id })

post_action_surface = render_surface(socket)
assert(find_node(post_action_surface, "botster-workspaces-row-#{workspace_id}"), "post-action surface did not rerender workspace")
assert(
  find_node(post_action_surface, "botster-workspaces-remove-current-#{workspace_id}-#{session_id}"),
  "post-action surface did not author the canonical current-session binding"
)
assert(
  find_node(post_action_surface, "botster-workspaces-remove-absent-#{workspace_id}-#{unknown_session_id}"),
  "single surface render did not author legible absent-reference history"
)

request(socket, { type: "shutdown_session", session_id: session_id })
ended_frame = wait_for_entity_frame(entity_socket, "ended session entity") do |frame|
  frame["type"] == "entity_patch" &&
    frame["id"] == session_id &&
    frame.dig("patch", "lifecycle_class") == "ended"
end
assert(ended_frame.fetch("snapshot_seq") > current_frame.fetch("snapshot_seq"), "ended patch was not ordered after current")
assert(
  call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("workspace", "session_refs").include?(session_id),
  "ended session entity update removed workspace history"
)

request(socket, { type: "shutdown_session", session_id: removed_session_id })
wait_for_entity_frame(entity_socket, "second ended session entity") do |frame|
  frame["type"] == "entity_patch" &&
    frame["id"] == removed_session_id &&
    frame.dig("patch", "lifecycle_class") == "ended"
end
request(socket, { type: "remove_session", session_id: removed_session_id })
removed_frame = wait_for_entity_frame(entity_socket, "removed session entity") do |frame|
  frame["type"] == "entity_remove" && frame["id"] == removed_session_id
end
assert(
  call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("workspace", "session_refs").include?(removed_session_id),
  "removed session entity silently discarded the workspace reference"
)

entity_socket.close
reconnected_entity_socket, reconnect_snapshot = open_session_entity_subscription(
  socket_path,
  "workspaces-lifecycle-reconnect-#{Process.pid}"
)
reconnect_items = reconnect_snapshot.fetch("items")
canonical_lifecycle_classes = %w[current ended indeterminate]
reconnect_items.each do |item|
  lifecycle_class = item.fetch("lifecycle_class")
  assert(
    canonical_lifecycle_classes.include?(lifecycle_class),
    "reconnect baseline exposed unknown lifecycle_class #{lifecycle_class.inspect}"
  )
end
assert(
  reconnect_items.any? { |item| item["session_uuid"] == session_id && item["lifecycle_class"] == "ended" },
  "reconnect baseline did not rehydrate retained ended session"
)
assert(
  reconnect_items.none? { |item| item["session_uuid"] == removed_session_id },
  "reconnect baseline retained explicitly removed session entity"
)
assert(removed_frame.fetch("snapshot_seq") > ended_frame.fetch("snapshot_seq"), "remove frame was not ordered after lifecycle patch")

delete_form = find_node(post_action_surface, "botster-workspaces-delete-form-#{workspace_id}")
assert(delete_form, "spawned workspace is missing the rendered Delete form")
deleted_action = action(
  socket,
  id: delete_form.dig("props", "action", "id"),
  node_id: delete_form.fetch("id"),
  kind: "submit",
  payload: delete_form.dig("props", "action", "payload")
)
assert(deleted_action["state"] == "accepted", "workspace Delete action failed")
deleted = deleted_action.fetch("payload")
assert(deleted["ok"] == true, "workspace Delete action payload failed")
assert(call_tool(socket, "botster_workspaces.show", { id: workspace_id }).dig("error", "code") == "workspace_not_found", "grouping still exists")
reconnected_entity_socket.close
after_delete_socket, after_delete_snapshot = open_session_entity_subscription(
  socket_path,
  "workspaces-lifecycle-after-delete-#{Process.pid}"
)
assert(
  after_delete_snapshot.fetch("items").any? { |item| item["session_uuid"] == session_id },
  "workspace delete terminated retained ended Hub session"
)
after_delete_socket.close
worktrees_after_delete = request(socket, { type: "list_worktrees" }).fetch("worktrees")
assert(
  worktrees_after_delete.any? { |worktree| worktree["worktree_id"] == worktree_id },
  "workspace delete removed managed worktree"
)

puts(
  "script/hub_acceptance_smoke: ok " \
  "protocol_version=#{hub_compatibility.fetch("protocol_version")} " \
  "conformance_fixture_revision=#{hub_compatibility.fetch("conformance_fixture_revision")} " \
  "workspace_id=#{workspace_id} target_id=#{target["target_id"]} " \
  "session_type_id=#{session_type_id} session_id=#{session_id} " \
  "spawn_node_id=#{spawn_button.fetch("id")} spawn_action_id=#{spawn_action.fetch("id")} " \
  "spawn_payload=#{JSON.generate(spawn_action["payload"])}"
)
