#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)

def read(path)
  File.read(File.join(ROOT, path))
end

def assert(condition, message)
  raise message unless condition
end

manifest = JSON.parse(read("botster-package.json"))
contract = JSON.parse(read("test/fixtures/workspaces/contract.json"))
readme = read("README.md")
domain_doc = read("docs/workspace-domain.md")
capabilities_doc = read("docs/capabilities.md")
gitignore = read(".gitignore")

assert(manifest["name"] == "botster-workspaces", "manifest name must be botster-workspaces")
assert(manifest["kind"] == "plugin", "manifest kind must be plugin")
assert(manifest["source"] == { "type" => "path", "path" => "." }, "manifest source must be the package path")
assert(manifest["capabilities"] == contract.fetch("manifest_capabilities"), "manifest capabilities must match contract")
assert(!manifest.key?("configuration"), "manifest must not retain workspace settings")

surfaces = manifest.fetch("surfaces")
assert(surfaces.length == 1, "manifest must declare one surface")
assert(surfaces.first["id"] == "workspaces", "stable workspaces surface is required")
assert(surfaces.first["kind"] == "app", "workspaces surface must be an app")
assert(
  surfaces.first["supports"] == ["render", "action"],
  "workspaces surface must support render and action"
)

navigation = manifest.fetch("navigation")
assert(navigation == contract.fetch("navigation"), "manifest navigation must match contract")
assert(navigation.length == 1, "manifest must declare one navigation entry")
assert(navigation.first.dig("target", "surface_id") == "workspaces", "navigation must target stable surface")

entrypoints = manifest.fetch("entrypoints")
assert(entrypoints == [{ "runtime" => "lua", "path" => "plugin.lua", "bootstrap" => false }], "one Lua entrypoint is required")

{
  "test/fixtures/session-type-package" => "botster-workspaces-acceptance-session-type",
}.each do |directory, package_name|
  fixture = JSON.parse(read(File.join(directory, "botster-package.json")))
  assert(fixture["name"] == package_name, "#{directory} must declare #{package_name}")
  assert(!fixture.key?("session_templates"), "#{directory} must not declare a superseded session_templates manifest key")
  session_types = fixture.fetch("session_types") { raise "#{directory} must declare session_types" }
  assert(session_types.length == 1, "#{directory} must declare exactly one acceptance session type")
  # Hub 8a60bd58 PackageSessionType requires these; a manifest omitting them
  # fails package validation rather than degrading to a default.
  %w[id label role interaction lifecycle command].each do |field|
    assert(!session_types.first[field].to_s.empty?, "#{directory} session type must declare #{field}")
  end
  assert(session_types.first["role"].include?("."), "#{directory} session type role must be a namespaced token")
end

# This fixture is the cold-cut negative control: it must keep the superseded
# manifest key so the real-daemon e2e spec can prove that key contributes no effective
# session type. It is pinned to that role rather than merely exempted from the
# token audit below.
legacy_negative_control = "test/fixtures/legacy-session-template-manifest/botster-package.json"
legacy_fixture = JSON.parse(read(legacy_negative_control))
assert(legacy_fixture["name"] == "botster-workspaces-legacy-manifest-negative", "legacy negative control changed package identity")
assert(legacy_fixture.key?("session_templates"), "legacy negative control must retain the superseded manifest key")
assert(!legacy_fixture.key?("session_types"), "legacy negative control must not declare the current manifest key")
assert(
  legacy_fixture.fetch("description").include?("cold-cut negative control"),
  "legacy negative control must declare its purpose in the manifest"
)

schema = contract.fetch("schema")
workspace_fields = schema.fetch("workspace_fields").sort
assert(workspace_fields == %w[created_at id name session_refs updated_at], "fixture must define exact five-field schema")
assert(schema["additional_properties"] == false, "fixture schema must reject additional properties")
assert(schema["legacy_state_error"] == "legacy_workspace_schema", "fixture must define typed legacy rejection")

names = []
memberships = []
contract.fetch("workspaces").each do |workspace|
  assert(workspace.keys.sort == workspace_fields, "fixture workspace must have exact five-field schema")
  assert(workspace["name"] == workspace["name"].strip && !workspace["name"].empty?, "fixture workspace name must be trimmed")
  assert(workspace["session_refs"].is_a?(Array), "session_refs must be an array")
  names << workspace["name"]
  workspace["session_refs"].each do |ref|
    assert(ref.keys.sort == %w[hub_id session_id], "session_refs entries must be { hub_id, session_id }")
    memberships << "#{ref["hub_id"]}/#{ref["session_id"]}"
  end
end
assert(names.uniq.length == names.length, "workspace names must be unique")
assert(memberships.uniq.length == memberships.length, "session membership must have one owner")

operations = contract.fetch("operations")
%w[create rename delete add_session move_session remove_session spawn].each do |operation|
  assert(operations.key?(operation), "fixture must define #{operation}")
end
assert(operations.dig("delete", "mode") == "remove_grouping_record", "delete must physically remove grouping")
assert(operations.dig("move_session", "one_state_write") == true, "move must be one state write")
assert(
  operations.dig("spawn", "hub_api") == "session_types.ensure_worktree_and_spawn",
  "spawn must call atomic Hub capability"
)
assert(
  operations.dig("spawn", "session_type_api") == "session_types.list",
  "spawn must project effective session types through the Hub session-type capability"
)
assert(
  operations.dig("spawn", "session_type_request_field") == "session_type_id",
  "spawn must name the authoritative session-type request field"
)
assert(operations.dig("spawn", "records") == "result.session_id", "spawn must record the returned session id")
assert(operations.dig("spawn", "caller_supplied_session_id") == false, "spawn must reject caller session id")

surface_contract = contract.fetch("surface")
assert(surface_contract["id"] == "workspaces", "fixture must preserve stable route")
assert(surface_contract["root_kind"] == "stack", "fixture must avoid duplicate host page chrome")
assert(surface_contract["host_owns_page_title"] == true, "fixture must assign the page title to the host")
assert(surface_contract["row_activation"] == true, "fixture must make each workspace row the open target")
assert(surface_contract["workspace_settings_group"] == %w[rename delete], "fixture must group workspace settings")
assert(surface_contract["initial_form_count"] == 0, "initial surface must contain no visible form")
assert(
  surface_contract["detail_actions"].sort == %w[add_session delete move_session remove_session rename spawn],
  "fixture must define all non-lifecycle detail actions"
)
assert(
  surface_contract.fetch("spawn_opener") == {
    "action_id" => "botster_workspaces.open_spawn",
    "handler_id" => "open_spawn_presentation_action",
  },
  "fixture must define the semantic Spawn opener and registered handler"
)
lifecycle_contract = surface_contract.fetch("lifecycle_grouping")
assert(lifecycle_contract["source"] == "/session", "fixture must use the canonical session entity family")
assert(
  lifecycle_contract["groups"] == %w[current indeterminate absent],
  "fixture must define canonical lifecycle and absence groups"
)
assert(lifecycle_contract["persists_lifecycle"] == false, "fixture must not persist lifecycle truth")
assert(lifecycle_contract["removes_ended_memberships"] == true, "fixture must remove confirmed ended memberships")
assert(lifecycle_contract["retains_unavailable_refs"] == true, "fixture must retain unavailable references")
assert(lifecycle_contract["bindings_per_reference_max"] == 3, "fixture must bound binding growth")
assert(contract.dig("entity_family", "name") == "botster-workspaces.workspace", "fixture must name entity family")

{
  "README.md" => [
    "Contextual session grouping",
    "New workspace",
    "Workspace settings",
    "session_types.list",
    "session_types.ensure_worktree_and_spawn",
    "session_type_id",
    "fresh Hub data directory",
  ],
  "docs/workspace-domain.md" => [
    "Exact Record",
    "Membership Invariant",
    "Rename and Delete",
    "Atomic Spawn",
    "Contextual Surface",
    "Lifecycle Projection",
  ],
  "docs/capabilities.md" => [
    "Declared Capabilities",
    "Plugin-Owned State",
    "Hub-Owned Authority",
    "Failure Atomicity",
  ],
}.each do |path, tokens|
  contents = read(path)
  tokens.each do |token|
    assert(contents.include?(token), "#{path} must mention #{token}")
  end
end

production_files = %w[
  README.md
  botster-package.json
  docs/workspace-domain.md
  docs/capabilities.md
]
obsolete_tokens = %w[
  purpose
  local_repo_ref
  spawn_target_ref
  default_session_template
  archive_policy
  workspaces-settings
  relative_worktree_hint
  spawn_default_session
]
production_files.each do |path|
  contents = read(path)
  obsolete_tokens.each do |token|
    assert(!contents.include?(token), "#{path} must not retain obsolete token #{token}")
  end
end

%w[.env mise.local.toml *.log tmp/ data/ dist/ build/].each do |pattern|
  assert(gitignore.lines.map(&:strip).include?(pattern), ".gitignore must include #{pattern}")
end

scanned_files = %w[
  botster-package.json
  README.md
  plugin.lua
  docs/workspace-domain.md
  docs/capabilities.md
  script/validate_ui_node_contract
  test/fixtures/legacy-session-template-manifest/botster-package.json
  test/fixtures/legacy-session-template-manifest/plugin.lua
  test/fixtures/legacy-session-template-manifest/bin/session.sh
  test/fixtures/session-type-package/botster-package.json
  test/fixtures/session-type-package/plugin.lua
  test/fixtures/session-type-package/bin/session.sh
  test/fixtures/workspaces/contract.json
  test/fixtures/orchestrator-producer/plugin.lua
  test/support.lua
  test/workspace_spec.lua
  test/membership_spec.lua
  test/events_spec.lua
  test/spawn_spec.lua
  test/surface_spec.lua
]
leak_patterns = {
  "absolute home path" => %r{/Users/[A-Za-z0-9._-]+},
  "email address" => /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i,
  "session id" => /sess-[0-9A-Za-z-]+/,
  "secret assignment" => /\b(secret|token|password|api[_-]?key)\b\s*[:=]/i,
}
scanned_files.each do |path|
  contents = read(path)
  leak_patterns.each do |label, pattern|
    assert(!contents.match?(pattern), "#{path} contains #{label}")
  end
end

# Cold-cut audit. Active source, manifests, fixtures, harnesses, and current
# documentation must carry no superseded session-template contract vocabulary.
# Historical docs/plans and docs/reports are immutable evidence and are excluded
# on purpose. script/test is excluded because it defines these literals.
cold_cut_files = scanned_files
forbidden_contract_tokens = %w[
  session_templates
  session_template_
  template_id
  .botster/session-templates.json
]
# Frozen pre-production create-argument keys. They contain session_template as a
# substring but are rejection vocabulary, not an active Hub contract, so they are
# stripped by exact key -- longest first -- rather than by prefix exemption.
frozen_obsolete_keys = %w[
  default_session_template_refs
  default_session_template_id
  default_session_template
]
# Lines that deliberately name a superseded token to prove it is rejected.
negative_control_marker = "cold-cut negative control"
cold_cut_files.each do |path|
  # The legacy-manifest fixture is the negative control itself; its role is pinned
  # by the explicit assertions above rather than by this scan.
  next if path == legacy_negative_control

  auditable = read(path).lines.reject { |line| line.include?(negative_control_marker) }.join
  frozen_obsolete_keys.each { |key| auditable = auditable.gsub(key, "") }
  forbidden_contract_tokens.each do |token|
    assert(!auditable.include?(token), "#{path} retains superseded session-template vocabulary #{token}")
  end
end

# Behaviour specs run in the Botster plugin test kit against the real Hub
# runtime (see README, "Testing"). BOTSTER_PLUGIN_TEST names the runner binary.
runner = ENV.fetch("BOTSTER_PLUGIN_TEST", "botster-plugin-test")
specs = Dir.glob(File.join(ROOT, "test", "*_spec.lua")).sort
assert(!specs.empty?, "kit specs are missing")

# The producer specs use the real botster-orchestrator manifest at a pinned
# commit (test/orchestrator.pin). BOTSTER_ORCHESTRATOR_PACKAGE may name a local
# checkout; it must be at that commit. Otherwise the pinned commit is cloned.
orchestrator_pin = read("test/orchestrator.pin").strip
orchestrator = ENV["BOTSTER_ORCHESTRATOR_PACKAGE"]
if orchestrator.nil? || orchestrator.empty?
  orchestrator = Dir.mktmpdir("botster-orchestrator-")
  repository = ENV.fetch("BOTSTER_ORCHESTRATOR_REPO", "https://github.com/trybotster/botster-orchestrator.git")
  assert(system("git", "clone", "--quiet", repository, orchestrator), "cannot clone #{repository}")
  assert(system("git", "-C", orchestrator, "checkout", "--quiet", orchestrator_pin), "cannot check out #{orchestrator_pin}")
end
orchestrator_head = IO.popen(["git", "-C", orchestrator, "rev-parse", "HEAD"], &:read).strip
assert(orchestrator_head == orchestrator_pin, "the orchestrator checkout must be at #{orchestrator_pin}, not #{orchestrator_head}")
assert(
  system({ "BOTSTER_ORCHESTRATOR_PACKAGE" => orchestrator }, runner, "--plugin", ROOT, *specs, chdir: ROOT),
  "kit specs failed"
)


puts "script/test: ok"
