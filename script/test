#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)

def read(path)
  File.read(File.join(ROOT, path))
end

def assert(condition, message)
  raise message unless condition
end

manifest = JSON.parse(read("botster-package.json"))
contract = JSON.parse(read("test/fixtures/workspaces/contract.json"))
plugin = read("plugin.lua")
readme = read("README.md")
domain_doc = read("docs/workspace-domain.md")
capabilities_doc = read("docs/capabilities.md")
gitignore = read(".gitignore")
hub_flow = read("script/test-hub-flow")
shared_stack_validator = read("script/validate_shared_stack_inputs")

assert(manifest["name"] == "botster-workspaces", "manifest name must be botster-workspaces")
assert(manifest["kind"] == "plugin", "manifest kind must be plugin")
assert(manifest["source"] == { "type" => "path", "path" => "." }, "manifest source must be the package path")
assert(manifest["capabilities"] == contract.fetch("manifest_capabilities"), "manifest capabilities must match contract")
assert(!manifest.key?("configuration"), "manifest must not retain workspace settings")

assert(hub_flow.include?("shared-stack validate-inputs"), "Hub flow must expose the shared-stack input profile")
%w[hub_binary session_worker_binary web_driver_source tui_driver_source].each do |token|
  assert(shared_stack_validator.include?(token), "shared-stack validator must require #{token}")
end

surfaces = manifest.fetch("surfaces")
assert(surfaces.length == 1, "manifest must declare one surface")
assert(surfaces.first["id"] == "workspaces", "stable workspaces surface is required")
assert(surfaces.first["kind"] == "app", "workspaces surface must be an app")
assert(
  surfaces.first["supports"] == ["render", "action"],
  "workspaces surface must support render and action"
)

navigation = manifest.fetch("navigation")
assert(navigation == contract.fetch("navigation"), "manifest navigation must match contract")
assert(navigation.length == 1, "manifest must declare one navigation entry")
assert(navigation.first.dig("target", "surface_id") == "workspaces", "navigation must target stable surface")

entrypoints = manifest.fetch("entrypoints")
assert(entrypoints == [{ "runtime" => "lua", "path" => "plugin.lua", "bootstrap" => false }], "one Lua entrypoint is required")

required_plugin_tokens = %w[
  botster_workspaces.create
  botster_workspaces.list
  botster_workspaces.show
  botster_workspaces.rename
  botster_workspaces.delete
  botster_workspaces.add_session
  botster_workspaces.move_session
  botster_workspaces.remove_session
  botster_workspaces.spawn
  botster_workspaces.entity_snapshot
  botster_workspaces.open
  botster_workspaces.select_spawn_target
  ensure_worktree_and_spawn
  session_templates
  spawn_targets
  plugin_db
  surface_route
  presentation_if
  selected-workspace
  workspace-dialog
  botster-workspaces.workspace
  bind_list
  lifecycle_class
  /session
]
required_plugin_tokens.each do |token|
  assert(plugin.include?(token), "plugin entrypoint must wire #{token}")
end

forbidden_implementation_tokens = %w[
  spawn_default_session
  refresh_template_diagnostics
  configured_archive_policy
  normalize_template_refs
  settings_surface
  spawn_session_template
  BOTSTER_CORE_PATH
]
forbidden_implementation_tokens.each do |token|
  assert(!plugin.include?(token), "plugin entrypoint must remove obsolete implementation #{token}")
end

schema = contract.fetch("schema")
workspace_fields = schema.fetch("workspace_fields").sort
assert(workspace_fields == %w[created_at id name session_refs updated_at], "fixture must define exact five-field schema")
assert(schema["additional_properties"] == false, "fixture schema must reject additional properties")
assert(schema["legacy_state_error"] == "legacy_workspace_schema", "fixture must define typed legacy rejection")

names = []
memberships = []
contract.fetch("workspaces").each do |workspace|
  assert(workspace.keys.sort == workspace_fields, "fixture workspace must have exact five-field schema")
  assert(workspace["name"] == workspace["name"].strip && !workspace["name"].empty?, "fixture workspace name must be trimmed")
  assert(workspace["session_refs"].is_a?(Array), "session_refs must be an array")
  names << workspace["name"]
  memberships.concat(workspace["session_refs"])
end
assert(names.uniq.length == names.length, "workspace names must be unique")
assert(memberships.uniq.length == memberships.length, "session membership must have one owner")

operations = contract.fetch("operations")
%w[create rename delete add_session move_session remove_session spawn].each do |operation|
  assert(operations.key?(operation), "fixture must define #{operation}")
end
assert(operations.dig("delete", "mode") == "remove_grouping_record", "delete must physically remove grouping")
assert(operations.dig("move_session", "one_state_write") == true, "move must be one state write")
assert(
  operations.dig("spawn", "hub_api") == "session_templates.ensure_worktree_and_spawn",
  "spawn must call atomic Hub capability"
)
assert(operations.dig("spawn", "records") == "result.session_id", "spawn must record returned UUID")
assert(operations.dig("spawn", "caller_supplied_session_id") == false, "spawn must reject caller session id")

surface_contract = contract.fetch("surface")
assert(surface_contract["id"] == "workspaces", "fixture must preserve stable route")
assert(surface_contract["initial_form_count"] == 0, "initial surface must contain no visible form")
assert(
  surface_contract["detail_actions"].sort == %w[add_session delete move_session remove_session rename spawn],
  "fixture must define all non-lifecycle detail actions"
)
lifecycle_contract = surface_contract.fetch("lifecycle_grouping")
assert(lifecycle_contract["source"] == "/session", "fixture must use the canonical session entity family")
assert(
  lifecycle_contract["groups"] == %w[current ended indeterminate absent],
  "fixture must define canonical lifecycle and absence groups"
)
assert(lifecycle_contract["persists_lifecycle"] == false, "fixture must not persist lifecycle truth")
assert(lifecycle_contract["bindings_per_reference_max"] == 4, "fixture must bound binding growth")
assert(contract.dig("entity_family", "name") == "botster-workspaces.workspace", "fixture must name entity family")

{
  "README.md" => [
    "Contextual session grouping",
    "New workspace",
    "Add or move an existing session",
    "session_templates.ensure_worktree_and_spawn",
    "fresh Hub data directory",
    "script/hub_acceptance_smoke",
  ],
  "docs/workspace-domain.md" => [
    "Exact Record",
    "Membership Invariant",
    "Rename and Delete",
    "Atomic Spawn",
    "Contextual Surface",
    "Lifecycle Projection",
  ],
  "docs/capabilities.md" => [
    "Declared Capabilities",
    "Plugin-Owned State",
    "Hub-Owned Authority",
    "Failure Atomicity",
  ],
}.each do |path, tokens|
  contents = read(path)
  tokens.each do |token|
    assert(contents.include?(token), "#{path} must mention #{token}")
  end
end

production_files = %w[
  README.md
  botster-package.json
  docs/workspace-domain.md
  docs/capabilities.md
]
obsolete_tokens = %w[
  purpose
  local_repo_ref
  spawn_target_ref
  default_session_template
  archive_policy
  workspaces-settings
  relative_worktree_hint
  spawn_default_session
]
production_files.each do |path|
  contents = read(path)
  obsolete_tokens.each do |token|
    assert(!contents.include?(token), "#{path} must not retain obsolete token #{token}")
  end
end

%w[fs. io.open os.execute File.read( File.write(].each do |token|
  assert(!plugin.include?(token), "plugin must not use direct filesystem API #{token}")
end

%w[list_sessions polling].each do |token|
  assert(!plugin.include?(token), "plugin must not synchronize lifecycle through #{token}")
end

%w[.env mise.local.toml *.log tmp/ data/ dist/ build/].each do |pattern|
  assert(gitignore.lines.map(&:strip).include?(pattern), ".gitignore must include #{pattern}")
end

scanned_files = %w[
  botster-package.json
  README.md
  plugin.lua
  docs/workspace-domain.md
  docs/capabilities.md
  script/hub_acceptance_smoke
  script/validate_shared_stack_inputs
  script/validate_ui_node_contract
  test/fixtures/workspaces/contract.json
  test/plugin_runtime_test.lua
]
leak_patterns = {
  "absolute home path" => %r{/Users/[A-Za-z0-9._-]+},
  "email address" => /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i,
  "session id" => /sess-[0-9A-Za-z-]+/,
  "secret assignment" => /\b(secret|token|password|api[_-]?key)\b\s*[:=]/i,
}
scanned_files.each do |path|
  contents = read(path)
  leak_patterns.each do |label, pattern|
    assert(!contents.match?(pattern), "#{path} contains #{label}")
  end
end

Dir.mktmpdir("botster-workspaces-shared-stack-inputs-") do |temporary_root|
  source_checkout = File.join(temporary_root, "source")
  Dir.mkdir(source_checkout)
  assert(system("git", "init", "--quiet", source_checkout), "shared-stack fixture Git init failed")
  assert(system("git", "-C", source_checkout, "config", "user.name", "Botster Workspaces Test"), "shared-stack fixture user.name failed")
  assert(system("git", "-C", source_checkout, "config", "user.email", "workspaces-test@example.invalid"), "shared-stack fixture user.email failed")

  hub_binary = File.join(source_checkout, "botster-hub")
  worker_binary = File.join(source_checkout, "botster-session-worker")
  File.write(hub_binary, "#!/bin/sh\nexit 0\n")
  File.write(worker_binary, "#!/bin/sh\nexit 0\n")
  File.chmod(0o755, hub_binary, worker_binary)
  assert(system("git", "-C", source_checkout, "add", "."), "shared-stack fixture Git add failed")
  assert(system("git", "-C", source_checkout, "commit", "--quiet", "-m", "Fixture"), "shared-stack fixture Git commit failed")
  revision = IO.popen(["git", "-C", source_checkout, "rev-parse", "HEAD"], &:read).strip

  artifacts = {
    "hub_binary" => {
      "kind" => "executable",
      "path" => hub_binary,
      "revision" => revision,
      "sha256" => Digest::SHA256.file(hub_binary).hexdigest,
      "source_checkout" => source_checkout,
    },
    "session_worker_binary" => {
      "kind" => "executable",
      "path" => worker_binary,
      "revision" => revision,
      "sha256" => Digest::SHA256.file(worker_binary).hexdigest,
      "source_checkout" => source_checkout,
    },
  }
  %w[core_source web_package tui_package workspaces_package ui_contract_source web_driver_source tui_driver_source].each do |name|
    artifacts[name] = { "kind" => "git_checkout", "path" => source_checkout, "revision" => revision }
  end

  valid_manifest = { "schema_version" => 1, "artifacts" => artifacts }
  manifest_path = File.join(temporary_root, "inputs.json")
  File.write(manifest_path, JSON.pretty_generate(valid_manifest))
  validator = File.join(ROOT, "script", "validate_shared_stack_inputs")
  hub_flow_command = File.join(ROOT, "script", "test-hub-flow")
  assert(
    system(hub_flow_command, "shared-stack", "validate-inputs", manifest_path, out: File::NULL),
    "valid shared-stack provenance was rejected"
  )

  invalid_digest = JSON.parse(File.read(manifest_path))
  invalid_digest["artifacts"]["hub_binary"]["sha256"] = "0" * 64
  File.write(manifest_path, JSON.pretty_generate(invalid_digest))
  assert(!system(validator, manifest_path, out: File::NULL, err: File::NULL), "shared-stack validator accepted a false binary digest")

  relative_path = JSON.parse(File.read(manifest_path))
  relative_path["artifacts"]["hub_binary"]["sha256"] = Digest::SHA256.file(hub_binary).hexdigest
  relative_path["artifacts"]["web_package"]["path"] = "../botster-web"
  File.write(manifest_path, JSON.pretty_generate(relative_path))
  assert(!system(validator, manifest_path, out: File::NULL, err: File::NULL), "shared-stack validator inferred a relative sibling path")

  revision_mismatch = JSON.parse(JSON.generate(valid_manifest))
  revision_mismatch["artifacts"]["web_package"]["revision"] = "0" * 40
  File.write(manifest_path, JSON.pretty_generate(revision_mismatch))
  assert(!system(validator, manifest_path, out: File::NULL, err: File::NULL), "shared-stack validator accepted a mismatched revision")

  File.write(manifest_path, JSON.pretty_generate(valid_manifest))
  File.write(File.join(source_checkout, "untracked"), "dirty\n")
  assert(!system(validator, manifest_path, out: File::NULL, err: File::NULL), "shared-stack validator accepted a dirty checkout")
end

lua = ENV.fetch("LUA", "lua")
test_path = File.join(ROOT, "test/plugin_runtime_test.lua")
assert(system(lua, test_path, chdir: ROOT), "Lua runtime test failed")
assert(
  !system({ "BOTSTER_WORKSPACES_INJECT_FAILURE" => "1" }, lua, test_path, chdir: ROOT, out: File::NULL, err: File::NULL),
  "Lua shell gate did not observe the deliberate failing assertion"
)

puts "script/test: ok"
