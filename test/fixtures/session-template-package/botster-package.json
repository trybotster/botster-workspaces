{
  "name": "botster-workspaces-acceptance-template",
  "version": "0.0.0",
  "kind": "plugin",
  "botster": ">=0.1.0",
  "source": { "type": "path", "path": "." },
  "capabilities": [],
  "entrypoints": [
    { "runtime": "lua", "path": "plugin.lua", "bootstrap": false }
  ],
  "session_templates": [
    {
      "id": "workspace-acceptance",
      "target_id": "workspaces-acceptance",
      "command": "bin/session.sh",
      "context": ["workspace_id", "prompt", "ticket_id", "branch_name"]
    }
  ]
}
