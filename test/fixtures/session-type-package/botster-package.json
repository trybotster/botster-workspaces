{
  "name": "botster-workspaces-acceptance-session-type",
  "version": "0.0.0",
  "kind": "plugin",
  "botster": ">=0.1.0",
  "source": { "type": "path", "path": "." },
  "capabilities": [],
  "entrypoints": [
    { "runtime": "lua", "path": "plugin.lua", "bootstrap": false }
  ],
  "session_types": [
    {
      "id": "workspace-acceptance",
      "label": "Workspace acceptance",
      "role": "botster.agent",
      "interaction": "interactive",
      "traits": ["acceptance"],
      "lifecycle": "task",
      "target_id": "workspaces-acceptance",
      "command": "bin/session.sh",
      "context": ["workspace_id", "prompt", "ticket_id", "branch_name"]
    }
  ]
}
