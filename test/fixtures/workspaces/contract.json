{
  "schema": {
    "workspace_fields": [
      "id",
      "name",
      "session_refs",
      "created_at",
      "updated_at"
    ],
    "additional_properties": false,
    "legacy_state_error": "legacy_workspace_schema"
  },
  "workspaces": [
    {
      "id": "ws_release_train_1",
      "name": "Release train",
      "session_refs": [
        "11111111-1111-4111-8111-111111111111",
        "22222222-2222-4222-8222-222222222222"
      ],
      "created_at": "plugin-clock-000001",
      "updated_at": "plugin-clock-000004"
    },
    {
      "id": "ws_review_queue_2",
      "name": "Review queue",
      "session_refs": [],
      "created_at": "plugin-clock-000002",
      "updated_at": "plugin-clock-000002"
    }
  ],
  "manifest_capabilities": [
    { "surface": "mcp" },
    { "surface": "plugin_db", "scope": "botster-workspaces" },
    { "surface": "surfaces" },
    { "surface": "session_actions", "scope": "session_type_managed_git_spawn" }
  ],
  "navigation": [
    {
      "id": "workspaces",
      "label": "Workspaces",
      "icon": "rectangle-group",
      "description": "Open the workspace records surface.",
      "target": { "kind": "surface", "surface_id": "workspaces" }
    }
  ],
  "operations": {
    "create": {
      "required": ["name"],
      "rejects_obsolete_fields": true,
      "name_trimmed": true,
      "name_unique": true
    },
    "rename": {
      "required": ["id", "name"],
      "preserves": ["id", "session_refs", "created_at"],
      "name_unique": true
    },
    "delete": {
      "mode": "remove_grouping_record",
      "releases_name": true,
      "does_not_delete": ["hub_sessions", "worktrees", "branches", "repositories"]
    },
    "add_session": {
      "one_owner": true,
      "duplicate_error": "session_already_owned"
    },
    "move_session": {
      "one_state_write": true,
      "removes_source": true,
      "adds_destination": true
    },
    "remove_session": {
      "grouping_only": true
    },
    "spawn": {
      "hub_api": "session_types.ensure_worktree_and_spawn",
      "target_first": true,
      "session_type_api": "session_types.list",
      "session_type_request_field": "session_type_id",
      "records": "result.session_id",
      "records_only_after_success": true,
      "caller_supplied_session_id": false
    }
  },
  "surface": {
    "id": "workspaces",
    "stable_route": true,
    "initial_form_count": 0,
    "presentation_keys": ["selected-workspace", "workspace-dialog"],
    "detail_actions": [
      "spawn",
      "rename",
      "delete",
      "add_session",
      "move_session",
      "remove_session"
    ],
    "spawn_opener": {
      "action_id": "botster_workspaces.open_spawn",
      "handler_id": "open_spawn_presentation_action"
    },
    "lifecycle_grouping": {
      "source": "/session",
      "identity_field": "session_uuid",
      "classification_field": "lifecycle_class",
      "groups": ["current", "ended", "indeterminate", "absent"],
      "reconciliation": ["entity_snapshot", "entity_upsert", "entity_patch", "entity_remove"],
      "persists_lifecycle": false,
      "retains_ended_and_unavailable_refs": true,
      "bindings_per_reference_max": 4
    }
  },
  "entity_family": {
    "name": "botster-workspaces.workspace",
    "source": "plugin-owned"
  }
}
